DATABASE_URL=postgresql://moc:moc_password@postgres:5432/mocai?schema=public
POSTGRES_PASSWORD=moc_password
REDIS_URL=redis://redis:6379
ADMIN_KEY=LEGACY_UNUSED_IN_V2
MASTER_ENCRYPTION_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
SESSION_DAYS=30
COOKIE_SECURE=false

# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=CHANGE_TO_RANDOM_VERIFY_TOKEN
META_OAUTH_STATE_SECRET=CHANGE_TO_ANOTHER_LONG_RANDOM_SECRET
META_REDIRECT_URI=https://ai.example.com/auth/facebook/callback
META_OAUTH_SCOPES=pages_show_list,pages_manage_metadata,pages_messaging,pages_read_engagement
META_GRAPH_VERSION=v23.0
PUBLIC_WEB_URL=http://localhost:3000

# V2 stores OpenAI API Key encrypted in PostgreSQL via Super Admin dashboard.
OPENAI_API_KEY=LEGACY_UNUSED_IN_V2
OPENAI_MODEL=gpt-4.1-mini

DEMO_MODE=true
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
