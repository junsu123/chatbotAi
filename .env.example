DATABASE_URL=postgresql://moc:moc_password@postgres:5432/mocai?schema=public
POSTGRES_PASSWORD=moc_password
REDIS_URL=redis://redis:6379
MASTER_ENCRYPTION_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
SESSION_DAYS=30
COOKIE_SECURE=false
DEFAULT_PHONE_COUNTRY_CODE=84

# OAuth state signing for Google/Facebook account login.
# If empty, META_OAUTH_STATE_SECRET is used as a fallback.
SOCIAL_OAUTH_STATE_SECRET=

# Email-only OTP verification. Generate OTP_PEPPER with: openssl rand -hex 32
OTP_PEPPER=
# Development only: prints OTP to API logs and returns devCode in responses.
# NEVER enable this in production.
OTP_DEV_MODE=false

# Email OTP via Resend. SMS OTP is intentionally disabled.
RESEND_API_KEY=
EMAIL_FROM=Moc Tam AI <no-reply@metachatbot.online>

# Meta / Facebook Page connection
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=CHANGE_TO_RANDOM_VERIFY_TOKEN
META_OAUTH_STATE_SECRET=CHANGE_TO_ANOTHER_LONG_RANDOM_SECRET
META_REDIRECT_URI=https://ai.example.com/auth/facebook/callback
META_OAUTH_SCOPES=pages_show_list,pages_manage_metadata,pages_messaging,pages_read_engagement
META_GRAPH_VERSION=v23.0
# Facebook Login for Business configuration used to connect Pages.
# Leave empty only if your Meta app supports classic scope-based Facebook Login.
META_LOGIN_CONFIG_ID=

# Facebook account sign-up / sign-in
FACEBOOK_LOGIN_REDIRECT_URI=https://ai.example.com/auth/social/facebook/callback
# Business-type Meta apps should use a dedicated Facebook Login for Business configuration.
FACEBOOK_SSO_CONFIG_ID=

# Google account sign-up / sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ai.example.com/auth/social/google/callback

PUBLIC_WEB_URL=http://localhost:3000

# OpenAI API Key is stored encrypted in PostgreSQL from the Super Admin dashboard.
DEMO_MODE=true
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
